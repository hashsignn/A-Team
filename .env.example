# =====================================================================
# .env.example — COPY TO .env AND FILL IN. NEVER COMMIT .env
# =====================================================================
# cp .env.example .env
#
# Everything here is OPTIONAL. The radar runs with none of it set:
#   - every feed is public or ships an example stand-in
#   - the reasoning model runs locally via Ollama, or not at all
#   - nothing is POSTed anywhere
#
# That is deliberate. A pipeline that needs a secret to demonstrate is a
# pipeline that cannot be demonstrated.

# ---------------------------------------------------------------------
# Reasoning model (optional)
# ---------------------------------------------------------------------
# Leave everything below unset to run on the deterministic router alone.
# The board is complete either way.

# Local, and the default. Nothing leaves the machine.
OLLAMA_HOST=http://localhost:11434
RADAR_LOCAL_MODEL=qwen2.5:7b-instruct

# Remote, and opt-in. Setting a key here sends article text to a third
# party — check that against your data classification before you do.
# ANTHROPIC_API_KEY=
RADAR_API_MODEL=claude-opus-5

# local | api | none.  Unset = auto-detect, local wins.
# RADAR_LLM_BACKEND=local

# ---------------------------------------------------------------------
# The two-model funnel (optional)
# ---------------------------------------------------------------------
# Two stages, split by COST rather than by job:
#
#   STAGE 1  triage    one yes/no over hundreds of headlines.
#                      Nearly a classification task, so a small model does it
#                      about as well as a large one — and it must be small,
#                      because it runs the most times.
#   STAGE 2  extract   reads the survivors properly and returns JSON. Where a
#                      conditional has to be read as a conditional, and where
#                      "the strait is shut" has to become "the freight behind
#                      it is stranded at a port the article never mentions".
#
# Both default to RADAR_LOCAL_MODEL, so a single-model install works unchanged.
#
# Suggested, all free and all runnable on a laptop:
#   RADAR_TRIAGE_MODEL=qwen2.5:3b-instruct     ~2 GB   fast, good enough
#   RADAR_EXTRACT_MODEL=qwen2.5:7b-instruct    ~5 GB   the default
#   RADAR_EXTRACT_MODEL=qwen2.5:14b-instruct  ~9 GB   noticeably better at
#                                                      second-order effects
# Pull them with:  ollama pull qwen2.5:3b-instruct
# RADAR_TRIAGE_MODEL=qwen2.5:3b-instruct
# RADAR_EXTRACT_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------
# External sources
# ---------------------------------------------------------------------
# OFF BY DEFAULT. Nothing in this tool reaches the internet until you set
# this, and every source falls back to a recorded fixture and says so on the
# /inputs panel. A tool that quietly starts calling nine external services the
# first time it runs is one nobody can deploy inside a corporate network.
#
# Everything in the shipped catalogue is FREE and KEYLESS. Turning this on
# costs nothing and requires no account.
# RADAR_ALLOW_NETWORK=1

# Per-request timeout, seconds, and the response size ceiling.
# RADAR_FEED_TIMEOUT=12
# RADAR_FEED_MAX_BYTES=8388608

# --- free, but each needs a free registration. Off unless set. --------
# ENTSOE_TOKEN=            # transparency.entsoe.eu — grid and plant outages
# OPENSANCTIONS_KEY=       # opensanctions.org — EU/OFAC/UN designations

# --- your own systems, wired through config/sources.yaml --------------
# The loader REFUSES a spec containing a literal token; it accepts only the
# NAME of a variable, which is then read from here at fetch time.
# CARRIER_NOTICES_URL=
# NAP_BASE_URL=
# NAP_API_KEY=

# ---------------------------------------------------------------------
# TMS integration (optional)
# ---------------------------------------------------------------------
# The radar does NOT post to a TMS. It exposes the payload at
# GET /api/v1/shipment-alerts and a separate process does the POST, so the
# credential never enters the radar's own address space.
#
# TMS_BASE_URL=
# TMS_BEARER_TOKEN=
# TMS_CLIENT_ID=

# Refuse to send anything, whatever else is configured. Leave this on until
# somebody has deliberately turned it off.
RADAR_DRY_RUN=1
