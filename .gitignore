# The customer's real data. config.example/ is the committed public stand-in.
config/

# Runtime state, caches, exports
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
data/cache/
data/exports/

# Field reports from drivers and on-site agents. OPERATIONAL DATA: it names
# real consignments and, once the app is in real hands, real people. It is
# also append-only evidence — committing it would put an audit log in a
# public history where it can never be redacted.
data/reports.jsonl
data/reports.*.jsonl

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Local dev
.dev-dashboard.log
.dev-api.log
.streamlit/secrets.toml

# =====================================================================
# CREDENTIALS — nothing below this line may ever be committed
# =====================================================================
# The radar itself needs no secret to run: every feed it uses is public or
# stubbed, and the reasoning model runs locally. These exist for the
# INTEGRATIONS — the TMS endpoint it POSTs to, and the optional API model.
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
credentials.json
service-account*.json
secrets.yaml
secrets.yml
